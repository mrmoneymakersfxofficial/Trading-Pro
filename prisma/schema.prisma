// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USUARIOS ──────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  role      String   @default("user") // "user" | "admin"
  brokerId  String?  // MT4/MT5 account ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses         UserLicense[]
  auditLogs        AuditLog[]
  payments         Payment[]
  tradingAccounts  TradingAccount[]
  transactions     Transaction[]
  commissions      Commission[]

  @@map("users")
}

// ─── LICENCIAS ────────────────────────────────────────────────
model License {
  id                String    @id @default(cuid())
  key               String    @unique // Formato: TP-XXXX-XXXX-XXXX-XXXX
  level             String    @default("standard") // "standard" | "pro"
  durationMonths    Int       @default(1) // 1, 3, 6, 12
  status            String    @default("available") // "available" | "assigned" | "active" | "payment_due" | "balance_low" | "expired" | "paused" | "revoked"
  assignedToEmail   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Bot verification fields
  clientName         String?
  clientEmail        String?
  machineId          String?   // MAC address del VPS (primer dispositivo que activa)
  accountNumber      Int?      // Número de cuenta MT5 vinculada
  minBalanceUsd      Decimal?  @default(600) // Balance mínimo en USD
  profitSharePercent Decimal?  @default(20) // % de ganancias que corresponde
  lastPaymentDate    DateTime?
  lastPaymentAmount  Decimal?
  revokedAt          DateTime?
  notes              String?
  expiresAt          DateTime? // Fecha de expiración de la licencia

  userLicenses UserLicense[]
  auditLogs    AuditLog[]

  @@map("licenses")
}

// ─── ASIGNACIÓN USUARIO ↔ LICENCIA ────────────────────────────
model UserLicense {
  id          String    @id @default(cuid())
  userId      String
  licenseId   String
  activatedAt DateTime?
  expiresAt   DateTime?
  status      String    @default("pending") // "active" | "expired" | "pending" | "paused" | "revoked"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([userId, licenseId])
  @@map("user_licenses")
}

// ─── AUDIT LOG ────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  licenseId String?
  action    String   // "license_activate" | "license_revoke" | "license_pause" | "license_resume" | "license_generate" | "payment_success" | "login" | "register"
  details   String?  // JSON string con detalles adicionales
  ipAddress String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── PAGOS (MercadoPago) ──────────────────────────────────────
model Payment {
  id                String   @id @default(cuid())
  userId            String
  mercadoPagoId     String?  // ID de la preferencia/pago en MP
  status            String   @default("pending") // "pending" | "approved" | "rejected" | "refunded"
  amount            Float
  currency          String   @default("USD")
  licenseLevel      String   // "standard" | "pro"
  licenseDuration   Int      // meses
  licenseId         String?  // Se llena cuando el pago es aprobado y se genera la licencia
  payerEmail        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── LICENSE CHECKS (audit del bot) ────────────────────────
model LicenseCheck {
  id             String   @id @default(uuid())
  licenseKey     String
  machineId      String?  @map("machine_id")
  accountNumber  Int?     @map("account_number")
  botVersion     String?  @map("bot_version")
  statusReturned String   @map("status_returned")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("license_checks")
}

// ─── TRADING ACCOUNTS ────────────────────────────────────────
model TradingAccount {
  id            String   @id @default(cuid())
  userId        String
  brokerName    String   @default("ICMarkets") @map("broker_name")
  accountNumber BigInt?  @map("account_number")
  accountType   String   @default("standard") @map("account_type")
  leverage      String   @default("1:500")
  baseCurrency  String   @default("USD") @map("base_currency")
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  equity        Decimal  @default(0) @db.Decimal(12, 2)
  dailyPnl      Decimal  @default(0) @map("daily_pnl") @db.Decimal(12, 2)
  totalPnl      Decimal  @default(0) @map("total_pnl") @db.Decimal(12, 2)
  openTrades    Int      @default(0) @map("open_trades")
  status        String   @default("pending")
  lastSyncAt    DateTime? @map("last_sync_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  commissions   Commission[]
  snapshots     AccountSnapshot[]

  @@map("trading_accounts")
}

// ─── TRANSACTIONS ────────────────────────────────────────────
model Transaction {
  id                String   @id @default(cuid())
  userId            String
  tradingAccountId  String?  @map("trading_account_id")
  type              String   // "deposito" | "retiro" | "comision" | "profit_share"
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  status            String   @default("pending") // "pending" | "completed" | "rejected"
  description       String?
  referenceId       String?  @map("reference_id")
  processedBy       String?  @map("processed_by")
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccount TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

// ─── COMMISSIONS ─────────────────────────────────────────────
model Commission {
  id               String   @id @default(cuid())
  userId           String
  tradingAccountId String?  @map("trading_account_id")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  grossProfit      Decimal  @default(0) @map("gross_profit") @db.Decimal(12, 2)
  commissionRate   Decimal  @default(20) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal  @default(0) @map("commission_amount") @db.Decimal(12, 2)
  status           String   @default("pending") // "pending" | "paid"
  paidAt           DateTime? @map("paid_at")
  paymentMethod    String?  @map("payment_method")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccount TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: SetNull)

  @@map("commissions")
}

// ─── ACCOUNT SNAPSHOTS ──────────────────────────────────────
model AccountSnapshot {
  id               String   @id @default(cuid())
  tradingAccountId String   @map("trading_account_id")
  balance          Decimal  @db.Decimal(12, 2)
  equity           Decimal  @db.Decimal(12, 2)
  dailyPnl         Decimal  @default(0) @map("daily_pnl") @db.Decimal(12, 2)
  openTrades       Int      @default(0) @map("open_trades")
  capturedAt       DateTime @default(now()) @map("captured_at")

  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@map("account_snapshots")
}
