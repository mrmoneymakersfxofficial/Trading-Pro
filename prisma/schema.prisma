// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USUARIOS ──────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  role      String   @default("user") // "user" | "admin"
  brokerId  String?  // MT4/MT5 account ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses   UserLicense[]
  auditLogs  AuditLog[]
  payments   Payment[]

  @@map("users")
}

// ─── LICENCIAS ────────────────────────────────────────────────
model License {
  id              String   @id @default(cuid())
  key             String   @unique // Formato: TP-XXXX-XXXX-XXXX-XXXX
  level           String   @default("standard") // "standard" | "pro"
  durationMonths  Int      @default(1) // 1, 3, 6, 12
  status          String   @default("available") // "available" | "assigned" | "paused" | "revoked"
  assignedToEmail String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userLicenses UserLicense[]
  auditLogs    AuditLog[]

  @@map("licenses")
}

// ─── ASIGNACIÓN USUARIO ↔ LICENCIA ────────────────────────────
model UserLicense {
  id          String    @id @default(cuid())
  userId      String
  licenseId   String
  activatedAt DateTime?
  expiresAt   DateTime?
  status      String    @default("pending") // "active" | "expired" | "pending" | "paused" | "revoked"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([userId, licenseId])
  @@map("user_licenses")
}

// ─── AUDIT LOG ────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  licenseId String?
  action    String   // "license_activate" | "license_revoke" | "license_pause" | "license_resume" | "license_generate" | "payment_success" | "login" | "register"
  details   String?  // JSON string con detalles adicionales
  ipAddress String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── PAGOS (MercadoPago) ──────────────────────────────────────
model Payment {
  id                String   @id @default(cuid())
  userId            String
  mercadoPagoId     String?  // ID de la preferencia/pago en MP
  status            String   @default("pending") // "pending" | "approved" | "rejected" | "refunded"
  amount            Float
  currency          String   @default("USD")
  licenseLevel      String   // "standard" | "pro"
  licenseDuration   Int      // meses
  licenseId         String?  // Se llena cuando el pago es aprobado y se genera la licencia
  payerEmail        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}
